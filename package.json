{
  "name": "llm-safecall",
  "version": "0.3.4",
  "description": "Secure, fail-safe, and observable LLM calls in Node/TypeScript with policy guardrails, secret scanning, streaming, and schema validation (zod).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "engines": { "node": ">=22" },
  "bin": { "llm-safecall": "dist/bin/cli.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "format": "prettier -w .",
    "test": "vitest --run"
  },
  "keywords": ["llm", "security", "policy", "guardrails", "zod", "copilot", "agent", "safety", "streaming"],
  "repository": { "type": "git", "url": "https://github.com/VODuda/llm-safecall-node.git" },
  "bugs": { "url": "https://github.com/VODuda/llm-safecall-node/issues" },
  "homepage": "https://github.com/VODuda/llm-safecall-node",
  "publishConfig": { "access": "public" },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "openai": "^4.57.0",
    "@anthropic-ai/sdk": "^0.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.7.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^5.0.5"
  }
}
