{
  "name": "llm-safecall",
  "version": "0.4.0",
  "description": "Policy checks, schema validation, retries, and logs for Node.js model calls.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "llm-safecall": "dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src bin tests",
    "format": "prettier -w .",
    "test": "vitest --run",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run build && npm test && npm run check:package",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "llm",
    "security",
    "policy",
    "guardrails",
    "zod",
    "copilot",
    "agent",
    "safety",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardianMesh/llm-safecall-node.git"
  },
  "bugs": {
    "url": "https://github.com/GuardianMesh/llm-safecall-node/issues"
  },
  "homepage": "https://github.com/GuardianMesh/llm-safecall-node",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.1",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "openai": "^7.43.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.5.1",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^5.0.5"
  }
}
